rules_version = '2';

// Deny by default. Every collection is opened explicitly and tested in
// functions/test/rules.test.ts. The phone holds the user's data; the server
// only sees the small collections below.
service cloud.firestore {
  match /databases/{database}/documents {

    // Weather cache: readable by any App Check-verified client, written only
    // by the cache function (Admin SDK bypasses rules).
    match /weather_cells/{cell} {
      allow read: if true;
      allow write: if false;
    }

    // Account metadata: the owner only.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function allowedKeys() {
        return request.resource.data.keys().hasOnly(['createdAt', 'backupPath', 'subscription']);
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && allowedKeys();
    }

    // Push tokens: registered and read only by the functions (Admin SDK).
    // A token identifies an install, never a person.
    match /push_tokens/{token} {
      allow read, write: if false;
    }

    // Deletion tombstones: written and cleared only by the purge functions
    // (Admin SDK), so a client can neither hide nor fake a deletion.
    match /account_deletions/{uid} {
      allow read, write: if false;
    }

    // Premium expiry per account: written only by the RevenueCat webhook
    // (Admin SDK); the owner may read their own.
    match /entitlements/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Report snapshots are read through the share-link function by token,
    // never directly.
    match /share_snapshots/{token} {
      allow read, write: if false;
    }

    // Opt-in audit counts arrive only through the auditCounts function,
    // which accepts the five counts and the model version. No client access.
    match /audit_counts/{doc} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
