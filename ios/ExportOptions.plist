<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App Store export for `flutter build ipa` (phase 39). Signing is
     manual with the profiles fastlane match installs; the team id is set
     by the release workflow from APPLE_TEAM_ID. -->
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store-connect</string>
	<key>signingStyle</key>
	<string>manual</string>
	<key>teamID</key>
	<string>APPLE_TEAM_ID</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>app.aurawell.mobile</key>
		<string>match AppStore app.aurawell.mobile</string>
		<key>app.aurawell.mobile.RiskWidget</key>
		<string>match AppStore app.aurawell.mobile.RiskWidget</string>
		<key>app.aurawell.mobile.watchkitapp</key>
		<string>match AppStore app.aurawell.mobile.watchkitapp</string>
		<key>app.aurawell.mobile.watchkitapp.complication</key>
		<string>match AppStore app.aurawell.mobile.watchkitapp.complication</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
