  "fixed_sql": [
    {
      "name": "attacks",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"attacks\" (\"id\" TEXT NOT NULL, \"started_at\" TEXT NOT NULL, \"ended_at\" TEXT NULL, \"intensity\" INTEGER NULL, \"head_locations\" TEXT NOT NULL DEFAULT '[]', \"phases\" TEXT NOT NULL DEFAULT '{}', \"symptoms\" TEXT NOT NULL DEFAULT '[]', \"notes\" TEXT NULL, \"pressure_sensor_hpa\" REAL NULL, \"pressure_station_hpa\" REAL NULL, \"weather\" TEXT NULL, \"finish_later\" INTEGER NOT NULL DEFAULT 0 CHECK (\"finish_later\" IN (0, 1)), \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "checkins",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"checkins\" (\"date\" TEXT NOT NULL, \"sleep_quality\" INTEGER NULL, \"stress\" INTEGER NULL, \"neck_tension\" INTEGER NULL, \"caffeine\" INTEGER NULL, \"hydration\" INTEGER NULL, \"alcohol\" INTEGER NULL, \"cycle_day\" INTEGER NULL, \"light_exposure\" INTEGER NULL, \"screen_exposure\" INTEGER NULL, \"sources\" TEXT NOT NULL DEFAULT '{}', \"weather\" TEXT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "medication_events",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"medication_events\" (\"id\" TEXT NOT NULL, \"attack_id\" TEXT NULL REFERENCES attacks (id) ON DELETE SET NULL, \"name\" TEXT NOT NULL, \"dose\" TEXT NULL, \"taken_at\" TEXT NOT NULL, \"relief_at2h\" INTEGER NULL, \"kind\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "weather_hours",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"weather_hours\" (\"cell\" TEXT NOT NULL, \"hour_utc\" TEXT NOT NULL, \"pressure_msl\" REAL NULL, \"surface_pressure\" REAL NULL, \"temperature\" REAL NULL, \"humidity\" REAL NULL, \"precipitation\" REAL NULL, \"wind\" REAL NULL, \"cloud\" REAL NULL, \"weather_code\" INTEGER NULL, \"uv\" REAL NULL, \"source\" TEXT NOT NULL DEFAULT 'open-meteo', \"fetched_at\" TEXT NOT NULL, \"pinned\" INTEGER NOT NULL DEFAULT 0 CHECK (\"pinned\" IN (0, 1)), PRIMARY KEY (\"cell\", \"hour_utc\"));"
        }
      ]
    },
    {
      "name": "environment_days",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"environment_days\" (\"date\" TEXT NOT NULL, \"cell\" TEXT NOT NULL, \"aqi_us\" REAL NULL, \"aqi_eu\" REAL NULL, \"pm25\" REAL NULL, \"pm10\" REAL NULL, \"ozone\" REAL NULL, \"pollen\" TEXT NULL, \"uv_max\" REAL NULL, \"daylight_minutes\" INTEGER NULL, \"sunrise\" TEXT NULL, \"sunset\" TEXT NULL, \"fetched_at\" TEXT NOT NULL, PRIMARY KEY (\"date\"));"
        }
      ]
    },
    {
      "name": "health_samples",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"health_samples\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"start\" TEXT NOT NULL, \"end\" TEXT NOT NULL, \"value\" REAL NOT NULL, \"unit\" TEXT NOT NULL, \"source_store\" TEXT NOT NULL, \"source_name\" TEXT NULL, \"imported_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"type\", \"start\", \"end\", \"source_store\"));"
        }
      ]
    },
    {
      "name": "factor_weights",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"factor_weights\" (\"factor\" TEXT NOT NULL, \"population_weight\" REAL NOT NULL, \"personal_weight\" REAL NOT NULL, \"confidence\" REAL NOT NULL, \"n_exposures\" INTEGER NOT NULL DEFAULT 0, \"n_attacks_after\" INTEGER NOT NULL DEFAULT 0, \"updated_at\" TEXT NOT NULL, PRIMARY KEY (\"factor\"));"
        }
      ]
    },
    {
      "name": "risk_days",
